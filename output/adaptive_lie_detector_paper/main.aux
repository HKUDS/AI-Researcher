\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Adversarial robustness ($n=200$ for Adv-FullRegex; $n=50$ for Adv-14, preliminary). \textbf  {LC} = lying-channel suppression: refusal markers drop selectively in lie trials; truth channel stays calibrated. \textbf  {Bi} = both channels disrupted (near-parity; Mistral~7B exception). At Adv-FullRegex ($n=200$): Llama~3B T-acc=33\%, L-acc=57\% (lie collapses $\Rightarrow $ LC); Mistral~7B T=96\%, L=12\% (both shifted $\Rightarrow $ Bi). Full distributions in Appendix~\ref {app:adv_n50}.}}{8}{table.caption.15}\protected@file@percent }
\newlabel{tab:adv_summary}{{2}{8}{Adversarial robustness ($n=200$ for Adv-FullRegex; $n=50$ for Adv-14, preliminary). \textbf {LC} = lying-channel suppression: refusal markers drop selectively in lie trials; truth channel stays calibrated. \textbf {Bi} = both channels disrupted (near-parity; Mistral~7B exception). At Adv-FullRegex ($n=200$): Llama~3B T-acc=33\%, L-acc=57\% (lie collapses $\Rightarrow $ LC); Mistral~7B T=96\%, L=12\% (both shifted $\Rightarrow $ Bi). Full distributions in Appendix~\ref {app:adv_n50}}{table.caption.15}{}}

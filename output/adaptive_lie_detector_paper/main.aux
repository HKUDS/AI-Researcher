\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Prompt-equalized detection accuracy by model scale (LOO pipeline in blue, hedging regex in orange; error bars: bootstrap 95\% CIs). The trend exhibits a two-tier structure: models $\leq $7B cluster at 61--74\% and models $\geq $14B at 82.5--84\% (group difference $p < 0.0001$), with no individual adjacent increment significant after Holm-Bonferroni correction. The within-family Qwen pair (7B: 74\%, 14B: 82.5\%) confirms the structure holds within a single family.}}{21}{figure.caption.51}\protected@file@percent }
\newlabel{fig:scale_trend}{{2}{21}{Prompt-equalized detection accuracy by model scale (LOO pipeline in blue, hedging regex in orange; error bars: bootstrap 95\% CIs). The trend exhibits a two-tier structure: models $\leq $7B cluster at 61--74\% and models $\geq $14B at 82.5--84\% (group difference $p < 0.0001$), with no individual adjacent increment significant after Holm-Bonferroni correction. The within-family Qwen pair (7B: 74\%, 14B: 82.5\%) confirms the structure holds within a single family}{figure.caption.51}{}}

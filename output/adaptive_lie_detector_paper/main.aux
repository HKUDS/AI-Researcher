\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architecture of the ADAGE pipeline. The target model defends a claim; the interrogator generates probing questions conditioned on dialogue history; the feature extractor rates five behavioral dimensions per response; the logistic regression classifier predicts deception probability; and the adaptive controller terminates when confidence exceeds $\tau $ or max questions are reached. Dashed arrow: feedback loop. The pipeline serves as an experimental vehicle; the contribution is the empirical findings, not the architecture.}}{5}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{5}{Architecture of the ADAGE pipeline. The target model defends a claim; the interrogator generates probing questions conditioned on dialogue history; the feature extractor rates five behavioral dimensions per response; the logistic regression classifier predicts deception probability; and the adaptive controller terminates when confidence exceeds $\tau $ or max questions are reached. Dashed arrow: feedback loop. The pipeline serves as an experimental vehicle; the contribution is the empirical findings, not the architecture}{figure.caption.3}{}}
